# Nur in Netlify (Site settings -> Environment variables) setzen. NIE ins Repo committen, NIE im Frontend verwenden.
# osu!-OAuth-App: https://osu.ppy.sh/home/account/edit -> OAuth
# Callback-URL der OAuth-App muss exakt so lauten:  https://DEINE-SEITE/.netlify/functions/auth
OSU_CLIENT_ID=
OSU_CLIENT_SECRET=
# Öffentliche URL der Seite ohne Slash am Ende (Fallback: von Netlify gesetzte URL)
SITE_URL=https://deine-seite.netlify.app
